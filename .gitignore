# =========================
# macOS Specific
# =========================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd

# =========================
# Python & Flask (Backend)
# =========================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
ENV/
.env
.flaskenv
instance/
.webassets-cache

# =========================
# Database (SQLite)
# =========================
# Prevents committing your local testing database
*.db
*.sqlite
*.sqlite3
*.db-journal

# =========================
# Celery & Redis (Batch Jobs)
# =========================
celerybeat-schedule
celerybeat-schedule.db
celerybeat-schedule.dir
celerybeat-schedule.bak
celerybeat.pid
*.log

# =========================
# Node.js & VueJS (Frontend)
# =========================
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# =========================
# User Uploads & Generated Files
# =========================
# Prevents committing user resumes, generated CSVs, and PDF reports
uploads/
exports/
static/uploads/
*.csv
*.pdf

# =========================
# IDEs & Editors
# =========================
.vscode/
.idea/
*.swp
*.swo
